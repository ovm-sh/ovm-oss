#!/bin/sh
set -e

echo "=== OVM pre-push ==="

# Refs arrive on stdin as "<local ref> <local sha> <remote ref> <remote sha>",
# one per line; $2 is the remote URL. Read them once up front with builtins
# only (the tag-guard test runs this hook with an empty PATH): both checks
# below need them, and stdin can only be read once.
PUSH_REFS=""
while IFS= read -r push_ref_line; do
    PUSH_REFS="${PUSH_REFS}${push_ref_line}
"
done
ZERO_SHA=0000000000000000000000000000000000000000

# A push that only deletes refs (`git push origin --delete branch`, tag
# cleanup) sends no code anywhere, so there is nothing for the gates to
# protect. Without this, pruning fourteen merged branches ran the fast gates
# and the full cargo test suite fourteen times (2026-09-14). An empty ref
# list is NOT a deletion: the reporting tests invoke the hook with no stdin
# and expect the full run.
SAW_REF=""
PUSHING_CODE=""
# shellcheck disable=SC2034  # git hands over four fields; not all are needed
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    SAW_REF="yes"
    [ "$local_sha" = "$ZERO_SHA" ] || PUSHING_CODE="yes"
done <<EOF
$PUSH_REFS
EOF
if [ -n "$SAW_REF" ] && [ -z "$PUSHING_CODE" ]; then
    echo "Only deletions to push; no code leaves this machine, so the gates are skipped."
    exit 0
fi

# A release tag is only pushed on a commit CI has already proven. The Release
# workflow refuses an unproven tag anyway, but only after a failed run and an
# email; refusing here costs nothing.
if [ "${OVM_HOOK_ALLOW_UNPROVEN_TAG:-}" != "1" ]; then
    remote_url="${2:-}"
    repo=$(printf '%s' "$remote_url" | sed -E 's#\.git$##; s#^.*[:/]([^/]+/[^/]+)$#\1#')
    # shellcheck disable=SC2034  # git hands over four fields; two are not needed
    while read -r local_ref local_sha remote_ref remote_sha; do
        case "$remote_ref" in
            refs/tags/v*) ;;
            *) continue ;;
        esac
        case "$local_sha" in
            "$ZERO_SHA") continue ;;
        esac
        commit=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null) || commit="$local_sha"
        if ! command -v gh > /dev/null 2>&1; then
            echo "ERROR: refusing to push $remote_ref: gh is not installed, so CI on $commit cannot be checked."
            echo "       Install gh, or set OVM_HOOK_ALLOW_UNPROVEN_TAG=1 to push an unproven tag."
            exit 1
        fi
        green=$(gh run list -R "$repo" --workflow CI --commit "$commit" \
            --json status,conclusion \
            --jq '[.[] | select(.status == "completed" and .conclusion == "success")] | length' 2>/dev/null) || green=""
        case "$green" in
            ''|*[!0-9]*) green=0 ;;
        esac
        if [ "$green" -gt 0 ]; then
            continue
        fi
        echo "ERROR: refusing to push $remote_ref: no successful CI run for $commit on $repo."
        echo "       Push the branch first, wait for CI to go green, then push the tag."
        echo "       Set OVM_HOOK_ALLOW_UNPROVEN_TAG=1 to push it anyway."
        exit 1
    done <<EOF
$PUSH_REFS
EOF
fi


# Git runs this hook with the repository pinned in the environment: from a
# linked worktree GIT_DIR points at .git/worktrees/<name>. Every test below
# builds throwaway repos with `git init`/`git commit`, and an inherited GIT_DIR
# sends those into THIS repository instead. On 2026-09-17 a push from a
# worktree committed fixture "one"/"two"/"seed" commits onto the branch being
# pushed (emptying main's tree) and wrote core.worktree into the shared
# .git/config. The hook's cwd is already the work tree, so git still finds the
# repo without them. Same list as dev_metadata.rs GIT_CONTEXT_ENV_VARS.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_COMMON_DIR \
    GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# The fast gates, first, because they fail in seconds and the test suite does
# not. Each one below caught a real bug that reached GitHub CI on 2026-09-14,
# when these hooks were installed as symlinks into a path two repo moves stale
# and git had been silently skipping them:
#
#   - no-early-exit-pipes: a `| head -1` that inverted a pipefail pipeline, so
#     the installer would report "no version found" precisely when it found one
#   - the python suite: a CSS class rename that left site/models.html unstyled
#   - the site sync: install.sh changed while site/install — the file ovm.sh
#     actually serves — kept the old bytes, making the fix true of the repo and
#     false of the installer anyone runs
#
# `cargo test` alone caught none of them: they live in CI's `scripts` and
# `hygiene` jobs, and `ci-local.py --quick` excludes `scripts` too. This is a
# deliberately fast subset (~15s), NOT a replacement for
# `python3 scripts/ci-local.py`, which reads ci.yml and so cannot drift.
echo "[1/4] Fast gates (shell syntax, pipefail shape, site assets, python)..."
FAST_FAILED=""
run_fast() {
    label=$1
    shift
    if "$@" >/dev/null 2>&1; then
        echo "  ok   $label"
    else
        echo "  FAIL $label"
        FAST_FAILED="yes"
    fi
}
[ -f tests/scripts/syntax-check.sh ] &&
    run_fast "shell syntax" bash tests/scripts/syntax-check.sh
[ -f tests/scripts/no-early-exit-pipes.sh ] &&
    run_fast "no early-exit consumer in a pipefail pipeline" \
        bash tests/scripts/no-early-exit-pipes.sh
# site/install is what ovm.sh serves. CI checks the COMMITTED copy; checking the
# working tree here is the earlier, cheaper version of the same question.
if [ -f install.sh ] && [ -f site/install ]; then
    run_fast "site/install matches install.sh" diff -q install.sh site/install
fi
for pytest_file in tests/python/test_*.py; do
    [ -f "$pytest_file" ] || continue
    run_fast "$(basename "$pytest_file")" python3 "$pytest_file"
done
if [ -n "$FAST_FAILED" ]; then
    echo "ERROR: a fast gate failed. These take seconds and mirror CI jobs that"
    echo "       take ten minutes and send an email. Fix before pushing."
    echo "       Full local run: python3 scripts/ci-local.py"
    exit 1
fi

# Run full test suite
echo "[2/4] Running full test suite..."
TESTS_STATE="passed"
if [ -f "Cargo.toml" ] || [ -f "crates/ovm/Cargo.toml" ]; then
    cargo test || {
        echo "ERROR: Tests failed. Fix before pushing."
        exit 1
    }
else
    TESTS_STATE="NOT RUN (no Cargo manifest here)"
    echo "  NOT RUN: no Cargo manifest found — the test suite did not run."
fi

# Agent review of unpushed commits. Opt-in only: it sends the unpushed diff
# to an external LLM service (codex or claude CLI), so contributors must
# explicitly enable it with OVM_HOOK_AI_REVIEW=1. Once enabled, a reviewer
# that cannot run is a failure: silently pushing unreviewed code is exactly
# what asking for a review was meant to prevent.
echo "[3/4] Agent review..."
REVIEW_STATE="NOT RUN (opt-in; set OVM_HOOK_AI_REVIEW=1)"
if [ "${OVM_HOOK_AI_REVIEW:-}" != "1" ]; then
    echo "  NOT RUN — opt-in. Set OVM_HOOK_AI_REVIEW=1 to send the unpushed diff to codex/claude."
    echo "  This is a review that did not happen, not a review that passed."
else
    if ! DIFF=$(git diff '@{upstream}..HEAD' 2>/dev/null); then
        DIFF=$(git diff 'HEAD~1..HEAD') || {
            echo "ERROR: review is enabled but the unpushed diff could not be computed."
            exit 1
        }
    fi
    if [ -z "$DIFF" ]; then
        echo "  No changes to review."
        REVIEW_STATE="no changes to review"
    else
        # Try codex first (when in a Claude Code session), fall back to claude.
        if command -v codex > /dev/null 2>&1; then
            REVIEWER=codex
        elif command -v claude > /dev/null 2>&1; then
            REVIEWER=claude
        else
            echo "ERROR: OVM_HOOK_AI_REVIEW=1 but neither codex nor claude is installed."
            echo "       Install one, or unset OVM_HOOK_AI_REVIEW to push without a review."
            exit 1
        fi

        echo "  Generating review of unpushed changes with $REVIEWER..."
        echo ""
        echo "$DIFF" | "$REVIEWER" -p "You are reviewing a diff for OVM, a Rust CLI version manager. Flag bugs, security issues, path leaks, and style problems. Be concise. If clean, say so." || {
            review_rc=$?
            echo ""
            echo "ERROR: $REVIEWER exited $review_rc — the review you asked for did not happen."
            echo "       Fix the reviewer, or unset OVM_HOOK_AI_REVIEW to push without one."
            exit 1
        }
        REVIEW_STATE="ran ($REVIEWER)"

        echo ""
        printf "Proceed with push? (Y/n) "
        if ! read -r response; then
            response=""
        fi
        if [ "$response" = "n" ] || [ "$response" = "N" ]; then
            echo "Push aborted."
            exit 1
        fi
    fi
fi

echo "[4/4] Pre-push done — tests: $TESTS_STATE; agent review: $REVIEW_STATE."
