#!/bin/sh
set -e

echo "=== OVM pre-push ==="

# A release tag is only pushed on a commit CI has already proven. The Release
# workflow refuses an unproven tag anyway, but only after a failed run and an
# email; refusing here costs nothing. Refs arrive on stdin as
# "<local ref> <local sha> <remote ref> <remote sha>"; $2 is the remote URL.
if [ "${OVM_HOOK_ALLOW_UNPROVEN_TAG:-}" != "1" ]; then
    remote_url="${2:-}"
    repo=$(printf '%s' "$remote_url" | sed -E 's#\.git$##; s#^.*[:/]([^/]+/[^/]+)$#\1#')
    # shellcheck disable=SC2034  # git hands over four fields; two are not needed
    while read -r local_ref local_sha remote_ref remote_sha; do
        case "$remote_ref" in
            refs/tags/v*) ;;
            *) continue ;;
        esac
        case "$local_sha" in
            0000000000000000000000000000000000000000) continue ;;
        esac
        commit=$(git rev-parse "${local_sha}^{commit}" 2>/dev/null) || commit="$local_sha"
        if ! command -v gh > /dev/null 2>&1; then
            echo "ERROR: refusing to push $remote_ref: gh is not installed, so CI on $commit cannot be checked."
            echo "       Install gh, or set OVM_HOOK_ALLOW_UNPROVEN_TAG=1 to push an unproven tag."
            exit 1
        fi
        green=$(gh run list -R "$repo" --workflow CI --commit "$commit" \
            --json status,conclusion \
            --jq '[.[] | select(.status == "completed" and .conclusion == "success")] | length' 2>/dev/null) || green=""
        case "$green" in
            ''|*[!0-9]*) green=0 ;;
        esac
        if [ "$green" -gt 0 ]; then
            continue
        fi
        echo "ERROR: refusing to push $remote_ref: no successful CI run for $commit on $repo."
        echo "       Push the branch first, wait for CI to go green, then push the tag."
        echo "       Set OVM_HOOK_ALLOW_UNPROVEN_TAG=1 to push it anyway."
        exit 1
    done
fi


# Run full test suite
echo "[1/3] Running full test suite..."
TESTS_STATE="passed"
if [ -f "Cargo.toml" ] || [ -f "crates/ovm/Cargo.toml" ]; then
    cargo test || {
        echo "ERROR: Tests failed. Fix before pushing."
        exit 1
    }
else
    TESTS_STATE="NOT RUN (no Cargo manifest here)"
    echo "  NOT RUN: no Cargo manifest found — the test suite did not run."
fi

# Agent review of unpushed commits. Opt-in only: it sends the unpushed diff
# to an external LLM service (codex or claude CLI), so contributors must
# explicitly enable it with OVM_HOOK_AI_REVIEW=1. Once enabled, a reviewer
# that cannot run is a failure: silently pushing unreviewed code is exactly
# what asking for a review was meant to prevent.
echo "[2/3] Agent review..."
REVIEW_STATE="NOT RUN (opt-in; set OVM_HOOK_AI_REVIEW=1)"
if [ "${OVM_HOOK_AI_REVIEW:-}" != "1" ]; then
    echo "  NOT RUN — opt-in. Set OVM_HOOK_AI_REVIEW=1 to send the unpushed diff to codex/claude."
    echo "  This is a review that did not happen, not a review that passed."
else
    if ! DIFF=$(git diff '@{upstream}..HEAD' 2>/dev/null); then
        DIFF=$(git diff 'HEAD~1..HEAD') || {
            echo "ERROR: review is enabled but the unpushed diff could not be computed."
            exit 1
        }
    fi
    if [ -z "$DIFF" ]; then
        echo "  No changes to review."
        REVIEW_STATE="no changes to review"
    else
        # Try codex first (when in a Claude Code session), fall back to claude.
        if command -v codex > /dev/null 2>&1; then
            REVIEWER=codex
        elif command -v claude > /dev/null 2>&1; then
            REVIEWER=claude
        else
            echo "ERROR: OVM_HOOK_AI_REVIEW=1 but neither codex nor claude is installed."
            echo "       Install one, or unset OVM_HOOK_AI_REVIEW to push without a review."
            exit 1
        fi

        echo "  Generating review of unpushed changes with $REVIEWER..."
        echo ""
        echo "$DIFF" | "$REVIEWER" -p "You are reviewing a diff for OVM, a Rust CLI version manager. Flag bugs, security issues, path leaks, and style problems. Be concise. If clean, say so." || {
            review_rc=$?
            echo ""
            echo "ERROR: $REVIEWER exited $review_rc — the review you asked for did not happen."
            echo "       Fix the reviewer, or unset OVM_HOOK_AI_REVIEW to push without one."
            exit 1
        }
        REVIEW_STATE="ran ($REVIEWER)"

        echo ""
        printf "Proceed with push? (Y/n) "
        if ! read -r response; then
            response=""
        fi
        if [ "$response" = "n" ] || [ "$response" = "N" ]; then
            echo "Push aborted."
            exit 1
        fi
    fi
fi

echo "[3/3] Pre-push done — tests: $TESTS_STATE; agent review: $REVIEW_STATE."
